# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/."

# Next Auth
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Next Auth GitHub Provider
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub Personal Access Token
# Required scope: read:public_repo
GITHUB_TOKEN=""

# Next Auth Google Provider
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Next Auth Discord Provider
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Mailjet — the only email transport, Send API v3.1. Drip sends from
# mail.hackwestern.com, transactional (signup/verify/reset/application) sends
# from the apex hackwestern.com.
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""

# Mailjet Event API webhook auth (src/pages/api/mailjet-webhook.ts). Mailjet
# doesn't sign payloads, so these ride in the registered webhook URL's userinfo
# and are checked as HTTP Basic auth. Keep them alphanumeric — percent-encoded
# userinfo round-trips inconsistently. Register with
# `npx tsx scripts/register-mailjet-webhook.ts --apply`.
MAILJET_WEBHOOK_USER=""
MAILJET_WEBHOOK_PASSWORD=""

# Kickbox email verification (optional). Set to enable the paid signup-email
# verification layer; leave blank to run free validation only.
KICKBOX_API_KEY=""

# Cloudflare R2
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="hw12-resumes"
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# Private (never public) R2 bucket for team finder photos on R2_ENDPOINT; blank turns photo upload off.
TEAM_FINDER_R2_BUCKET=""
# Access key scoped to that bucket.
TEAM_FINDER_R2_ACCESS_KEY_ID=""
# Secret for that access key.
TEAM_FINDER_R2_SECRET_ACCESS_KEY=""
# ISO 8601 time the team finder opens for hackers; blank = when RSVP closes. Vercel Preview only.
TEAM_FINDER_OPENS_AT=""

# Hacking window for commit-timing cheat checks (ISO 8601 UTC). Required to run commit checks.
HACK_START=""
HACK_END=""

# Project submission deadline (ISO 8601 UTC, e.g. 2026-11-22T20:00:00Z).
# Submissions after this are marked "late". Leave empty for no deadline.
PROJECT_SUBMISSION_DEADLINE=""

# When sponsor judging closes (ISO 8601 with offset, YYYY-MM-DDTHH:MM:SS-05:00).
# After it sponsors can't score, shortlist or submit. Leave empty and judging never closes.
SPONSOR_JUDGING_CLOSES_AT=""

# Bearer token guarding /api/cheat-check/sweep. The sweep worker re-invokes
# itself with this, so automated sweeps are disabled while it is unset.
CHEAT_SWEEP_SECRET=""


# Load Tester Tokens
# Bearer token guarding /api/docs/app (the generated API map). Endpoint returns
# 503 while unset.
HW_NETWORK_REQUESTS_APP_MAP_TOKEN=""

# Cloudflare Worker (workers/hw-network-requests) that stores request events in D1.
HW_NETWORK_REQUESTS_INGEST_URL="http://localhost:8787"

# You can generate a new secret on the command line with:
# openssl rand -base64 32
HW_NETWORK_REQUESTS_INGEST_TOKEN=""

# Local dev records nothing unless this is "true". When testing, point
# HW_NETWORK_REQUESTS_INGEST_URL at the local worker (http://localhost:8787,
# `npm run load-tester:dev`) so it lands in local SQLite, instead of prod D1 on Cloudflare.
HW_NETWORK_REQUESTS_TRACK_LOCAL=false


# Live site checklist: where "Join the Slack" / "Join the Devpost" send
# hackers. The Slack invite has no default (the repo is public), so that button
# is hidden while this is blank. Devpost falls back to src/utils/urls.ts.
ONBOARDING_SLACK_URL=""
ONBOARDING_DEVPOST_URL=""

# Hacker interest form Google Sheet ID
HACKER_INTEREST_FORM=""

# Google Sheets writes (Sponsor Judging and Coffee Chat Bookings tabs,
# shortlists, sponsor info, room grid) happen only in production. Set to 1 to
# let a dev server write to the real sheet. Leave blank in dev: the service
# account is Editor on the live sheet. Tests never write, even with this set.
SHEET_WRITES=""

# Marketing notification bot (HW13)
# Leave disabled until recipient emails and test mode are ready.
MARKETING_NOTIFICATIONS_ENABLED="0"
MARKETING_NOTIFICATION_TEST_MODE="0"
# Optional test recipient override; defaults to Allison.
MARKETING_NOTIFICATION_TEST_RECIPIENT="Allison"
# Comma-separated schedule task IDs that should not send.
MARKETING_NOTIFICATION_SKIP_IDS=""
# Optional override for deployments where the CSV is stored elsewhere.
MARKETING_NOTIFICATION_SCHEDULE_PATH=""
# Slack account emails in order: Allison, Brittney, Anson, Jamie.
MARKETING_SLACK_EMAILS='["","","",""]'
# Optional Slack ID fallback for an empty email slot.
MARKETING_ALLISON_SLACK_USER_ID=""
MARKETING_BRITTNEY_SLACK_USER_ID=""
MARKETING_ANSON_SLACK_USER_ID=""
MARKETING_JAMIE_SLACK_USER_ID=""

# Organizer run-of-show reminders (docs/organizer-notifications.md).
# 1 = live, 0 = off (a sync while off cancels queued organizer DMs).
ORGANIZER_NOTIFICATIONS_ENABLED="0"
# 1 = every live DM goes to the test person instead, labelled.
ORGANIZER_NOTIFICATION_TEST_MODE="0"
ORGANIZER_NOTIFICATION_TEST_RECIPIENT="Jasmine"
# Who gets the "what to fix in the sheet" DM; blank = nobody.
ORGANIZER_NOTIFICATION_ADMIN="Jasmine"
# Names that get no DMs, comma separated.
ORGANIZER_NOTIFICATION_SKIP_NAMES=""
# Fix a Slack account by name: '{"Name":"U123"}' (id or email).
ORGANIZER_SLACK_IDS=""
# Local CSV copies instead of the live sheets (optional).
ORGANIZER_RUN_OF_SHOW_PATH=""
ORGANIZER_CONTACTS_PATH=""

# Auto-Ping mentor / volunteer / judge DMs (docs/auto-ping.md).
# 1 = live, 0 = off (a --sync while off cancels queued Auto-Ping DMs).
AUTO_PING_ENABLED="0"
# Who --send-test DMs (a Slack email).
AUTO_PING_TEST_EMAIL="jazz.gu2004@gmail.com"
# A folder of CSVs named after the tabs ("People.csv", "Messages.csv", ...)
# instead of the live sheet, for --preview / --review / --send-test.
AUTO_PING_SNAPSHOT_DIR=""
# 1 = log counts only (set in CI; Actions logs are public).
AUTO_PING_QUIET="0"
